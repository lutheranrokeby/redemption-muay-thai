# Netlify & Supabase Environment Variables Example
# Add these variables in your Netlify site configuration (Site Settings -> Environment Variables)

# 1. Custom Admin Portal Password (REQUIRED)
VITE_ADMIN_PASSWORD=your_custom_admin_password_here

# 2. Supabase Credentials
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 3. Netlify Option B Build Hook Webhook URL
VITE_NETLIFY_BUILD_HOOK_URL=https://api.netlify.com/build_hooks/your-build-hook-id