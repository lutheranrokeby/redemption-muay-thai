# Netlify & Supabase Environment Variables Example
# Add these variables in your Netlify site configuration (Site Settings -> Environment Variables)

VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
VITE_NETLIFY_BUILD_HOOK_URL=https://api.netlify.com/build_hooks/your-build-hook-id
